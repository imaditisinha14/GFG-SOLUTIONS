class Solution {
    void rearrange(ArrayList<Integer> arr) {
        ArrayList<Integer> pos = new ArrayList<>();
        ArrayList<Integer> neg = new ArrayList<>();

        // Separate positive and negative numbers
        for (int x : arr) {
            if (x >= 0)
                pos.add(x);
            else
                neg.add(x);
        }

        arr.clear();

        int i = 0, j = 0;

        // Start with positive
        while (i < pos.size() && j < neg.size()) {
            arr.add(pos.get(i++));
            arr.add(neg.get(j++));
        }

        // Add remaining elements
        while (i < pos.size()) {
            arr.add(pos.get(i++));
        }

        while (j < neg.size()) {
            arr.add(neg.get(j++));
        }
    }
}
