class Solution {
    static int largestPrimeFactor(int n) {
        
        int ans = 1;

        for (int i = 2; i * i <= n; i++) {
            
            while (n % i == 0) {
                ans = i;
                n = n / i;
            }
        }

        // If n is still greater than 1,
        // it is a prime factor
        if (n > 1) {
            ans = n;
        }

        return ans;
    }
}
