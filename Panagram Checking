class Solution {
    public static boolean checkPangram(String s) {
        // code here
        s = s.toLowerCase();
        boolean[] seen = new boolean[26];
        for(int i=0;i<s.length();i++){
            char ch = s.charAt(i);
            if(ch>='a' && ch<= 'z'){
                seen[ch - 'a'] = true;
            }
        }
        for(int i=0;i<26;i++){
            if(seen[i]==false){
                return false;
            }
            
        }
        return true;
    }
}
