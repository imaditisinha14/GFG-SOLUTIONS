class Solution {
    // Function for adding one to the number represented by the array
    Vector<Integer> addOne(int[] arr) {
        Vector<Integer> result = new Vector<>();

        int n = arr.length;

        // Start from the last digit
        for (int i = n - 1; i >= 0; i--) {
            if (arr[i] < 9) {
                arr[i]++;
                
                // Add all elements to result
                for (int num : arr) {
                    result.add(num);
                }
                return result;
            }

            arr[i] = 0;
        }

        // If all digits were 9
        result.add(1);
        for (int i = 0; i < n; i++) {
            result.add(0);
        }

        return result;
    }
}
